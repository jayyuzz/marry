# ===== Konfigurasi proyek "marry" =====
# Salin file ini menjadi .env lalu isi nilainya.
# (JANGAN commit .env ke git — .gitignore sudah mengecualikannya)

# --- Gateway AI lokal (9router) ---
# Endpoint gateway di PC kamu. Biarkan default kalau 9router jalan di port 20128.
AI_BASE_URL=http://localhost:20128/v1

# API key gateway: buka http://localhost:20128/dashboard lalu copy token/key di bagian API Keys.
# > Tanpa ini, aplikasi akan jalan tapi analisis AI tidak akan bisa dipanggil.
AI_API_KEY=GANTI_ME

# Model yang dipakai untuk analisis.
# Opsi yang tersedia di gateway-mu (cepat/gratis):
#   - oc/muse-spark-1.2-contributor-free
#   - oc/muse-spark-1.3-contributor-free
#   - oc/jev-1.13-free
#   - cf/@cf/meta/llama-3.1-70b-instruct-fp8-fast   (lebih besar, lebih lambat)
#   - nvidia/nemotron-3-ultra-550b-a55b            (paling besar)
AI_MODEL=ag/gemini-3.8-flash

# --- Server ---
PORT=3000

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
